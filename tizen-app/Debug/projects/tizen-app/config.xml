<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://openiptv.app"
        version="1.0.0"
        viewmodes="maximized">

    <name>WilsonTV</name>
    <description>WilsonTV - IPTV Player for Samsung Smart TV</description>
    <author href="https://github.com/EasternSam">EasternSam</author>
    <icon src="icon.png"/>
    <content src="index.html"/>

    <tizen:application id="KVDNDMFMi0.openiptv" package="KVDNDMFMi0" required_version="6.0"/>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <access origin="*" subdomains="true"/>

    <tizen:content-security-policy>
        default-src * 'self' 'unsafe-inline' 'unsafe-eval' data: blob:;
        media-src * blob:;
        img-src * data: blob:;
        connect-src *;
        frame-src *;
        script-src * 'unsafe-inline' 'unsafe-eval';
        style-src * 'unsafe-inline';
    </tizen:content-security-policy>
</widget>
