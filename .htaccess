RewriteEngine On

# Redirigir rutas limpias a archivos HTML
RewriteRule ^remote$ /remote.html [L]
RewriteRule ^panel$ /panel.html [L]

# Redirigir API de Node.js al PHP API
RewriteRule ^api/data$ /api.php?action=data [L,QSA]
RewriteRule ^api/playlists$ /api.php?action=playlists [L,QSA]
RewriteRule ^api/last-playlist$ /api.php?action=last-playlist [L,QSA]
RewriteRule ^api/favorites$ /api.php?action=favorites [L,QSA]
RewriteRule ^api/proxy$ /api.php?action=proxy [L,QSA]
RewriteRule ^api/remote/pair$ /api.php?action=remote-pair [L,QSA]
RewriteRule ^api/remote/tv-connect$ /api.php?action=remote-tv-poll [L,QSA]
RewriteRule ^api/remote/phone-connect$ /api.php?action=remote-phone-connect [L,QSA]
RewriteRule ^api/remote/command$ /api.php?action=remote-command [L,QSA]
RewriteRule ^api/remote/sync$ /api.php?action=remote-sync [L,QSA]
RewriteRule ^api/remote/check$ /api.php?action=remote-check [L,QSA]
RewriteRule ^api/remote/tv-state$ /api.php?action=remote-tv-state [L,QSA]
